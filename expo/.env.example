# Supabase — copy to expo/.env and fill in
# Project settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project settings → API → Project API keys → anon public
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Anthropic — backend only, NEVER expose to client (no EXPO_PUBLIC_ prefix).
# Read at request time by the Expo Router API route in
# app/api/trpc/[...trpc]+api.ts (which proxies into backend/hono.ts).
# console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: override the API base URL. Only needed for production builds
# that point at a remote API. In dev, leave blank — web uses same origin,
# native derives the host from the Expo dev server.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
